<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".fragments.search.SearchTvFragment">

    <androidx.leanback.widget.VerticalGridView
        android:id="@+id/vgv_search"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:descendantFocusability="afterDescendants"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:listitem="@layout/item_movie_tv" />

    <include
        android:id="@+id/is_loading"
        layout="@layout/layout_is_loading_tv"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@id/vgv_search"
        app:layout_constraintEnd_toEndOf="@id/vgv_search"
        app:layout_constraintStart_toStartOf="@id/vgv_search"
        app:layout_constraintTop_toTopOf="@id/vgv_search" />

    <LinearLayout
        android:id="@+id/search_header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="100dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="100dp"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_search"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_search_edittext">

            <androidx.leanback.widget.SearchEditText
                android:id="@+id/et_search"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:drawableStart="@drawable/ic_search"
                android:drawablePadding="10dp"
                android:drawableTint="#FFFFFF"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:gravity="center_vertical"
                android:hint="@string/search_input_hint"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1"
                android:nextFocusRight="@+id/btn_search_clear"
                android:nextFocusDown="@id/ll_global_search"
                android:padding="14dp"
                android:textSize="16sp"
                app:layout_constraintEnd_toStartOf="@+id/btn_search_clear"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageView
                android:id="@+id/btn_search_clear"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="8dp"
                android:layout_marginBottom="4dp"
                android:background="@drawable/bg_btn_exoplayer_tv"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:nextFocusRight="@+id/btn_search_voice"
                android:padding="10dp"
                android:src="@drawable/ic_search_clear"
                android:tint="#FFFFFF"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintEnd_toStartOf="@+id/btn_search_voice"
                app:layout_constraintTop_toTopOf="parent"
                tools:ignore="ContentDescription,PrivateResource,UseAppTint" />

            <ImageView
                android:id="@+id/btn_search_voice"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="8dp"
                android:layout_marginBottom="4dp"
                android:background="@drawable/bg_btn_exoplayer_tv"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:padding="10dp"
                android:src="@drawable/ic_mic"
                android:tint="#FFFFFF"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:ignore="PrivateResource,UseAppTint" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <LinearLayout
            android:id="@+id/ll_global_search"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_btn_exoplayer_tv"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:nextFocusDown="@id/sp_content_type"
            android:orientation="horizontal"
            android:padding="8dp">

            <TextView
                android:id="@+id/tv_global_search"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/global_search"
                android:textColor="@android:color/white"
                android:textSize="18sp" />

            <ImageView
                android:id="@+id/iv_global_search_switch"
                android:layout_width="48dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_switch_off"
                tools:ignore="ContentDescription" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/ll_advanced_filters"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_filter_panel_tv"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="16dp"
            android:paddingEnd="18dp"
            android:paddingBottom="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Filtri avanzati"
                android:textColor="@android:color/white"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Combina liberamente i criteri: vengono applicati tutti insieme."
                android:textColor="#A9B2C2"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="start|center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="138dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp"
                    android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:layout_marginBottom="4dp" android:text="Tipo" android:textColor="#A9B2C2" android:textSize="12sp" />
                    <FrameLayout android:layout_width="match_parent" android:layout_height="44dp" android:addStatesFromChildren="true" android:background="@drawable/bg_filter_control_tv">
                        <Spinner android:id="@+id/sp_content_type" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@android:color/transparent" android:focusable="true" android:nextFocusRight="@id/sp_italian" android:nextFocusDown="@id/et_date_from" android:paddingEnd="34dp" android:spinnerMode="dropdown" />
                        <ImageView android:layout_width="18dp" android:layout_height="18dp" android:layout_gravity="end|center_vertical" android:layout_marginEnd="10dp" android:duplicateParentState="true" android:src="@drawable/ic_filter_chevron_down" tools:ignore="ContentDescription" />
                    </FrameLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="120dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp"
                    android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:layout_marginBottom="4dp" android:text="Italiano" android:textColor="#A9B2C2" android:textSize="12sp" />
                    <FrameLayout android:layout_width="match_parent" android:layout_height="44dp" android:addStatesFromChildren="true" android:background="@drawable/bg_filter_control_tv">
                        <Spinner android:id="@+id/sp_italian" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@android:color/transparent" android:focusable="true" android:nextFocusLeft="@id/sp_content_type" android:nextFocusRight="@id/sp_year" android:nextFocusDown="@id/et_date_to" android:paddingEnd="34dp" android:spinnerMode="dropdown" />
                        <ImageView android:layout_width="18dp" android:layout_height="18dp" android:layout_gravity="end|center_vertical" android:layout_marginEnd="10dp" android:duplicateParentState="true" android:src="@drawable/ic_filter_chevron_down" tools:ignore="ContentDescription" />
                    </FrameLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="116dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp"
                    android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:layout_marginBottom="4dp" android:text="Anno" android:textColor="#A9B2C2" android:textSize="12sp" />
                    <FrameLayout android:layout_width="match_parent" android:layout_height="44dp" android:addStatesFromChildren="true" android:background="@drawable/bg_filter_control_tv">
                        <Spinner android:id="@+id/sp_year" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@android:color/transparent" android:focusable="true" android:nextFocusLeft="@id/sp_italian" android:nextFocusRight="@id/sp_genre" android:nextFocusDown="@id/et_actor_search" android:paddingEnd="34dp" android:spinnerMode="dropdown" />
                        <ImageView android:layout_width="18dp" android:layout_height="18dp" android:layout_gravity="end|center_vertical" android:layout_marginEnd="10dp" android:duplicateParentState="true" android:src="@drawable/ic_filter_chevron_down" tools:ignore="ContentDescription" />
                    </FrameLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="190dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:layout_marginBottom="4dp" android:text="Genere" android:textColor="#A9B2C2" android:textSize="12sp" />
                    <FrameLayout android:layout_width="match_parent" android:layout_height="44dp" android:addStatesFromChildren="true" android:background="@drawable/bg_filter_control_tv">
                        <Spinner android:id="@+id/sp_genre" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@android:color/transparent" android:focusable="true" android:nextFocusLeft="@id/sp_year" android:nextFocusDown="@id/et_actor_search" android:paddingEnd="34dp" android:spinnerMode="dropdown" />
                        <ImageView android:layout_width="18dp" android:layout_height="18dp" android:layout_gravity="end|center_vertical" android:layout_marginEnd="10dp" android:duplicateParentState="true" android:src="@drawable/ic_filter_chevron_down" tools:ignore="ContentDescription" />
                    </FrameLayout>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="start|bottom"
                android:orientation="horizontal">

                <LinearLayout android:layout_width="116dp" android:layout_height="wrap_content" android:layout_marginEnd="12dp" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:layout_marginBottom="4dp" android:text="Dal" android:textColor="#A9B2C2" android:textSize="12sp" />
                    <FrameLayout android:layout_width="match_parent" android:layout_height="44dp" android:addStatesFromChildren="true" android:background="@drawable/bg_filter_control_tv">
                        <Spinner android:id="@+id/et_date_from" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@android:color/transparent" android:focusable="true" android:nextFocusUp="@id/sp_content_type" android:nextFocusRight="@id/et_date_to" android:nextFocusDown="@id/btn_reset_filters" android:paddingEnd="34dp" android:spinnerMode="dropdown" />
                        <ImageView android:layout_width="18dp" android:layout_height="18dp" android:layout_gravity="end|center_vertical" android:layout_marginEnd="10dp" android:duplicateParentState="true" android:src="@drawable/ic_filter_chevron_down" tools:ignore="ContentDescription" />
                    </FrameLayout>
                </LinearLayout>

                <LinearLayout android:layout_width="116dp" android:layout_height="wrap_content" android:layout_marginEnd="12dp" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:layout_marginBottom="4dp" android:text="Al" android:textColor="#A9B2C2" android:textSize="12sp" />
                    <FrameLayout android:layout_width="match_parent" android:layout_height="44dp" android:addStatesFromChildren="true" android:background="@drawable/bg_filter_control_tv">
                        <Spinner android:id="@+id/et_date_to" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@android:color/transparent" android:focusable="true" android:nextFocusUp="@id/sp_italian" android:nextFocusLeft="@id/et_date_from" android:nextFocusRight="@id/et_actor_search" android:nextFocusDown="@id/btn_reset_filters" android:paddingEnd="34dp" android:spinnerMode="dropdown" />
                        <ImageView android:layout_width="18dp" android:layout_height="18dp" android:layout_gravity="end|center_vertical" android:layout_marginEnd="10dp" android:duplicateParentState="true" android:src="@drawable/ic_filter_chevron_down" tools:ignore="ContentDescription" />
                    </FrameLayout>
                </LinearLayout>

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:layout_marginBottom="4dp" android:text="Attore" android:textColor="#A9B2C2" android:textSize="12sp" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="44dp" android:orientation="horizontal">
                        <androidx.leanback.widget.SearchEditText
                            android:id="@+id/et_actor_search"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_filter_control_tv"
                            android:focusable="true"
                            android:focusableInTouchMode="true"
                            android:hint="Scrivi il nome dell'attore..."
                            android:imeOptions="actionSearch"
                            android:inputType="textPersonName"
                            android:maxLines="1"
                            android:nextFocusLeft="@id/et_date_to"
                            android:nextFocusRight="@id/btn_actor_mode"
                            android:nextFocusDown="@id/hgv_actor_suggestions"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:textColor="@android:color/white"
                            android:textColorHint="#7FFFFFFF"
                            android:textSize="15sp" />
                        <Button
                            android:id="@+id/btn_actor_mode"
                            android:layout_width="92dp"
                            android:layout_height="44dp"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_filter_action_secondary_tv"
                            android:focusable="true"
                            android:nextFocusLeft="@id/et_actor_search"
                            android:nextFocusDown="@id/btn_apply_filters"
                            android:text="Cerca"
                            android:textAllCaps="false"
                            android:textColor="@android:color/white"
                            android:textSize="14sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <androidx.leanback.widget.HorizontalGridView
                android:id="@+id/hgv_actor_suggestions"
                android:layout_width="match_parent"
                android:layout_height="136dp"
                android:layout_marginTop="8dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:nextFocusUp="@id/et_actor_search"
                android:nextFocusDown="@id/btn_apply_filters"
                android:paddingStart="4dp"
                android:paddingTop="4dp"
                android:paddingEnd="4dp"
                android:paddingBottom="4dp"
                android:visibility="gone"
                tools:visibility="visible" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:gravity="end|center_vertical"
                android:orientation="horizontal">
                <Button
                    android:id="@+id/btn_reset_filters"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_filter_action_secondary_tv"
                    android:focusable="true"
                    android:nextFocusRight="@id/btn_apply_filters"
                    android:nextFocusDown="@id/vgv_search"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:text="Azzera"
                    android:textAllCaps="false"
                    android:textColor="@android:color/white"
                    android:textSize="14sp" />
                <Button
                    android:id="@+id/btn_apply_filters"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_filter_action_primary_tv"
                    android:focusable="true"
                    android:nextFocusLeft="@id/btn_reset_filters"
                    android:nextFocusDown="@id/vgv_search"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:text="Applica filtri"
                    android:textAllCaps="false"
                    android:textColor="#07111D"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
