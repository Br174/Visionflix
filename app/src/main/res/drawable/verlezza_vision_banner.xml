<?xml version="1.0" encoding="utf-8"?>
<!-- Compose the TV banner from the verified logo, without the damaged PNG. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <size android:width="320dp" android:height="180dp" />
            <solid android:color="#000000" />
        </shape>
    </item>
    <item>
        <inset android:insetLeft="70dp" android:insetRight="70dp">
            <bitmap
                android:src="@drawable/verlezza_vision_logo"
                android:gravity="fill"
                android:filter="true" />
        </inset>
    </item>
</layer-list>
