# UAB-CORE-V1.1 thin adapter: Visionflix / Verlezza Vision
UAB_ENGINE_VERSION="UAB-CORE-V1.1"
UAB_PROJECT_NAME="Visionflix"
UAB_PROJECT_CLASS="android"
UAB_MOTHER_REF="main"
UAB_LAB_PREFIX="lab/"
UAB_CANDIDATE_PREFIX="candidate/"
UAB_MOTHER_PREFIX="mother/"
UAB_BUILD_ROUTE="GitHub Actions / Mobile+TV Gradle build"
UAB_CACHE_MODE="gradle"
UAB_RELEASE_MODE="immutable-mother"
UAB_CORE_REGRESSION_GATES="mobile build,TV build,stable signing certificate,version/package validation,TV launcher,Downloader publication integrity,requested feature"
UAB_ANDROID_PACKAGE_STRATEGY="stable-update for approved Mother; isolated package for experiments when required"
UAB_SIGNING_STRATEGY="stable signing identity"
UAB_PATCH_REPACK="conditional"
UAB_OUTPUT_TYPES="mobile-apk,tv-apk,sha256"
UAB_DELIVERY_ADAPTER="Br174/streamflix-BV"
UAB_LAB_SCOPE="one requested modification or one small inseparable change-set"
UAB_CANDIDATE_METHOD="fresh from exact LAB source Mother; replay exact approved LAB change-set"
UAB_MOTHER_PROMOTION_METHOD="new Mother source ref points to exact approved Candidate source SHA; packaging/signing may differ only as declared metadata"
UAB_PROMOTION_TRACE_REQUIRED="on"
UAB_LEGACY_TV_LATEST_OVERWRITE="deprecated as Mother storage"
